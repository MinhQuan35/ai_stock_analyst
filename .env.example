# ===== Azure OpenAI (via Foundry) =====
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21

# ===== Azure Model Deployments =====
AZURE_CHAT_DEPLOYMENT=gpt-4o
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ===== Cohere Rerank (via Foundry) =====
COHERE_RERANK_DEPLOYMENT=Cohere-rerank-v4.0-fast
COHERE_RERANK_MODEL=Cohere-rerank-v4.0-fast

# ===== Qdrant Cloud =====
# Get free account at https://cloud.qdrant.io
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=stock_knowledge
QDRANT_VECTOR_SIZE=3072

# ===== Application =====
APP_NAME=rag-stock-analyst
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# ===== RAG Settings =====
# top_k: Retrieve this many docs from vector store
# top_n: After rerank, keep this many docs
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=20
RAG_TOP_N=5
RAG_DATA_DIR=./data/raw
RAG_USE_RERANKER=true
RAG_VECTOR_BACKEND=qdrant  # "qdrant" or "faiss"

# ===== LLM Settings =====
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2000
