# ===== Azure OpenAI =====
# Get these from Azure AI Foundry > Project > Settings
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21

# ===== Model Deployments =====
# Names of your deployed models in Azure AI Foundry
AZURE_CHAT_DEPLOYMENT=gpt-4o
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ===== Application =====
APP_NAME=rag-stock-analyst
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# ===== RAG Settings =====
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_DATA_DIR=./data/raw
RAG_VECTOR_STORE_DIR=./data/vector_store

# ===== LLM Settings =====
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2000
